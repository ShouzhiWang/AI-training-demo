# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Enable after the hosted Magic Link template contains {{ .Token }}.
NEXT_PUBLIC_EMAIL_OTP_ENABLED=false

# Browser-safe URL for the Phase 4/5 FastAPI service.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Copy backend/.env.example to backend/.env for server-only credentials.
# Never prefix the Supabase service key or DeepSeek key with NEXT_PUBLIC_.
